<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Akatsukisoft.Kelpie.Core</PackageId>
    <Title>Kelpie Core</Title>
    <Authors>Akatsukisoft</Authors>
    <Company>Akatsukisoft</Company>
    <Copyright>Copyright (c) 2026 Akatsukisoft</Copyright>
    <Description>Core runtime utilities and shared server control options for KelpieSSH.</Description>
    <PackageTags>kelpie;kelpiessh;ssh;mcp;vps</PackageTags>
    <PackageProjectUrl>https://github.com/katsushoe/KelpieSSH</PackageProjectUrl>
    <RepositoryUrl>https://github.com/katsushoe/KelpieSSH</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Version>0.3.0.0-alpha</Version>
    <AssemblyVersion>0.3.0.0</AssemblyVersion>
    <FileVersion>0.3.0.0</FileVersion>
    <InformationalVersion>0.3.0.0-alpha</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <IsPackable>true</IsPackable>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.8" />
  </ItemGroup>

</Project>
