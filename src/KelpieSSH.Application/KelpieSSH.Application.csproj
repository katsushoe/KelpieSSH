<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.0" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
    <ProjectReference Include="..\KelpieSSH.Domain\KelpieSSH.Domain.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <PackageId>Akatsukisoft.KelpieSSH.Application</PackageId>
    <Title>KelpieSSH Application</Title>
    <Authors>Akatsukisoft</Authors>
    <Company>Akatsukisoft</Company>
    <Copyright>Copyright (c) 2026 Akatsukisoft</Copyright>
    <Description>Application services, policies, and SSH command abstractions for KelpieSSH.</Description>
    <PackageTags>kelpie;kelpiessh;ssh;mcp;vps</PackageTags>
    <PackageProjectUrl>https://github.com/katsushoe/KelpieSSH</PackageProjectUrl>
    <RepositoryUrl>https://github.com/katsushoe/KelpieSSH</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Version>0.3.7.0-alpha</Version>
    <AssemblyVersion>0.3.7.0</AssemblyVersion>
    <FileVersion>0.3.7.0</FileVersion>
    <InformationalVersion>0.3.7.0-alpha</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <IsPackable>true</IsPackable>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
