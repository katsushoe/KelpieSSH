{
  "Host": {
    "Address": "example.invalid",
    "Port": 22
  },
  "Auth": {
    "UserName": "deploy",
    "Method": "privateKey",
    "PrivateKeyFile": "vps01_ed25519"
  },
  "Connection": {
    "TimeoutSeconds": 10
  },
  "Platform": {
    "OsFamily": "debian"
  },
  "Mode": "Safe",
  "Capabilities": [
    "AllowListPackage"
  ],
  "AllowedRoots": {
    "/var/www": "@Read|@Write|@List|@CD",
    "/var/log": "@Read|@List"
  },
  "SpecialPaths": {
    "**/.env": "Deny",
    "**/.ssh/**": "Deny",
    "/var/www/.well-known/**": "Allow"
  },
  "HostReboot": {
    "Enabled": false,
    "ExpectedKernel": "",
    "Services": [],
    "HttpUrls": [],
    "TimeoutSeconds": 120,
    "PollSeconds": 3,
    "Paths": {
      "Sudo": "/usr/bin/sudo",
      "Systemctl": "/usr/bin/systemctl",
      "Cat": "/usr/bin/cat",
      "Uname": "/usr/bin/uname",
      "Curl": "/usr/bin/curl",
      "BootId": "/proc/sys/kernel/random/boot_id",
      "NullDevice": "/dev/null"
    }
  }
}
